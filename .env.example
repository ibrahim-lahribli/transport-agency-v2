# Environment variables
#
# Copy this file to .env.local and adjust as needed:
#   cp .env.example .env.local
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser. Never
# put secrets (booking keys, payment credentials, API tokens) here.

# Absolute site origin. Used for canonical URLs, Open Graph metadata and the
# sitemap that ships with the catalogue pages.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default UI locale for the app shell. Arabic (ar) is wired in later together
# with the RTL pass; the copy currently ships English and French (see
# /data/source/services-report.md).
NEXT_PUBLIC_DEFAULT_LOCALE=en
