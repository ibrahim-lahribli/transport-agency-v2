# Environment variables
#
# Copy this file to .env.local and adjust as needed:
#   cp .env.example .env.local
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser. Never
# put secrets (booking keys, payment credentials, API tokens) here.

# Absolute site origin. Used for canonical URLs, Open Graph metadata and the
# sitemap that ships with the catalogue pages.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default UI locale for the app shell. Arabic (ar) is wired in later together
# with the RTL pass; the copy currently ships English and French (see
# /data/source/services-report.md).
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Business configuration — required (T) values from services-report.md
# In production, builds fail if any of these values remain empty or placeholders.
BUSINESS_LEGAL_NAME="Agadir Tourisme SARL"
BUSINESS_ICE="002938475000082"
BUSINESS_LICENCE="LIC-2026-SOUSS-AGD"
BUSINESS_INSURANCE="RC Pro Tourisme Assurance - Police 987654"
BUSINESS_WHATSAPP="+212600123456"
BUSINESS_EMAIL="contact@agadirtourisme.ma"
BUSINESS_ADDRESS="Avenue Mohammed V, 80000 Agadir, Maroc"
BUSINESS_TRADING_NAME="Agadir Tourisme"
NEXT_PUBLIC_EUR_TO_MAD_RATE=10.8

# Local/CI escape hatch: set to "true" to skip the production placeholder check
# in config/business.ts. Never set it in a real deployment.
# SKIP_ENV_VALIDATION=true
